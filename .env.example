# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID (get it from @userinfobot)
CHAT_ID=your_telegram_chat_id_here

# SQLite database file path
DATABASE_PATH=bardi.db

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Anthropic API Key — only needed if you want Claude Opus 4.6 for /breakdown
# and post-checkin motivation. Leave blank to use free built-in templates.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
