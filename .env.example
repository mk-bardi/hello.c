# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your personal Telegram Chat ID (get it from @userinfobot)
CHAT_ID=your_telegram_chat_id_here

# SQLite database file path
# Use /data/bardi.db on Render with persistent disk, or bardi.db for local dev
DATABASE_PATH=bardi.db
